# These rules must be listed here because uCore/Fedora's 99-default-disable.preset
# ends with a catch-all "disable *" that wins over a plain systemctl enable done at
# build time (ostree re-applies presets on first boot / every deployment).
# Sorted before 99- so these rules match first.

# Zincati is the CoreOS Cincinnati-protocol auto-updater. It requires
# ignition.platform.id on the kernel cmdline, which is absent on qcow2-provisioned
# VMs (deployed without Ignition). Updates are handled by rpm-ostreed-automatic.timer.
disable zincati.service

# Stage new OCI image versions automatically in the background (mirrors Bazzite's
# uupd behaviour). Takes effect on the next reboot.
enable rpm-ostreed-automatic.timer

# On the very first boot after a fresh qcow2 deploy, stage a rebase from the
# localhost/ reference baked in by bootc-image-builder to the canonical GHCR
# remote so rpm-ostreed-automatic.timer has a real upstream to pull from.
enable ublue-rebase-ghcr.service

# Afterburn handles platform-specific first-boot tasks (hostname, SSH keys) for
# CoreOS cloud deployments. Cloud-init covers all of that for our Proxmox VMs,
# so Afterburn is redundant and would race with cloud-init over the same settings.
disable afterburn-checkin.service
disable afterburn-firstboot-checkin.service
disable afterburn-sshkeys.target

# Ignition services: Ignition is not used on qcow2-provisioned VMs (we use
# cloud-init). These services all exit harmlessly with no config present, but
# disabling them keeps the boot log clean.
disable coreos-check-ssh-keys.service
disable coreos-ignition-delete-config.service
disable coreos-ignition-firstboot-complete.service
disable coreos-ignition-write-issues.service
disable ignition-delete-config.service

# iSCSI: not used on this Docker host VM.
disable iscsi-onboot.service
disable iscsi-starter.service
disable iscsid.socket
disable iscsiuio.socket

# ZFS: managed by Proxmox on the host; not needed inside the guest VM.
disable zfs-import-cache.service
disable zfs-mount.service
disable zfs-share.service
disable zfs-volume-wait.service
disable zfs-zed.service
disable zfs-import.target
disable zfs.target

# mdmonitor: software RAID monitoring — irrelevant in a VM with a single virtual disk.
disable mdmonitor.service

# udisks2: desktop-oriented disk management daemon — not needed on a headless server.
disable udisks2.service

# fwupd-refresh: firmware update checks — VMs don't have updatable firmware.
disable fwupd-refresh.timer
